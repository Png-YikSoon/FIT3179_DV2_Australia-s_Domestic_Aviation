{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly domestic airline passengers, July 2014 to July 2026, with 12-month average.",
  "width": "container",
  "height": 354,
  "data": {
    "url": "data/01_trend_monthly_passengers.csv"
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": "2020-03-01",
            "end": "2021-12-01"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#f0efec"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "temporal"
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-04-01",
            "label": "COVID-19 border closures"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "y": 12,
        "color": "#52514e",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1,
        "color": "#86b6ef"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "tickCount": "year"
          }
        },
        "y": {
          "field": "passengers",
          "type": "quantitative",
          "title": "Passengers per month",
          "axis": {
            "format": "~s"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.passengers_12m_avg > 0"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "passengers_12m_avg",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2019-10-01",
            "y": 5644116,
            "tx": "2016-09-01",
            "ty": 5900000,
            "text": [
              "October 2019: a record month,",
              "5.6 million passengers"
            ],
            "tx_end": "2019-06-01"
          },
          {
            "date": "2020-04-01",
            "y": 145895,
            "tx": "2016-03-01",
            "ty": 1500000,
            "text": [
              "April 2020: only 146,000 passengers,",
              "97% fewer than April 2019"
            ],
            "tx_end": "2019-08-01"
          },
          {
            "date": "2021-08-01",
            "y": 726527,
            "tx": "2022-10-01",
            "ty": 1250000,
            "text": [
              "August 2021: Delta outbreak",
              "lockdowns in Sydney and Melbourne"
            ],
            "tx_end": "2022-10-01"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#86b6ef",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "x2": {
          "field": "tx_end"
        },
        "y2": {
          "field": "ty"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2019-10-01",
            "y": 5644116,
            "tx": "2016-09-01",
            "ty": 5900000,
            "text": [
              "October 2019: a record month,",
              "5.6 million passengers"
            ],
            "tx_end": "2019-06-01"
          },
          {
            "date": "2020-04-01",
            "y": 145895,
            "tx": "2016-03-01",
            "ty": 1500000,
            "text": [
              "April 2020: only 146,000 passengers,",
              "97% fewer than April 2019"
            ],
            "tx_end": "2019-08-01"
          },
          {
            "date": "2021-08-01",
            "y": 726527,
            "tx": "2022-10-01",
            "ty": 1250000,
            "text": [
              "August 2021: Delta outbreak",
              "lockdowns in Sydney and Melbourne"
            ],
            "tx_end": "2022-10-01"
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 110,
        "filled": false,
        "color": "#1f63b8",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2019-10-01",
            "y": 5644116,
            "tx": "2016-09-01",
            "ty": 5900000,
            "text": [
              "October 2019: a record month,",
              "5.6 million passengers"
            ],
            "tx_end": "2019-06-01"
          },
          {
            "date": "2020-04-01",
            "y": 145895,
            "tx": "2016-03-01",
            "ty": 1500000,
            "text": [
              "April 2020: only 146,000 passengers,",
              "97% fewer than April 2019"
            ],
            "tx_end": "2019-08-01"
          },
          {
            "date": "2021-08-01",
            "y": 726527,
            "tx": "2022-10-01",
            "ty": 1250000,
            "text": [
              "August 2021: Delta outbreak",
              "lockdowns in Sydney and Melbourne"
            ],
            "tx_end": "2022-10-01"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 11.5,
        "color": "#1f63b8",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "tx",
          "type": "temporal"
        },
        "y": {
          "field": "ty",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "encodings": [
              "x"
            ],
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.6
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "format": "%B %Y",
            "title": "Month"
          },
          {
            "field": "passengers",
            "type": "quantitative",
            "format": ",",
            "title": "Passengers"
          },
          {
            "field": "passengers_12m_avg",
            "type": "quantitative",
            "format": ",.0f",
            "title": "12-month average"
          },
          {
            "field": "load_factor",
            "type": "quantitative",
            "format": ".1f",
            "title": "Seats filled (%)"
          }
        ]
      }
    }
  ]
}